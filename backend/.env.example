PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dukaan_management
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173
TIMEZONE=Africa/Mogadishu
# false = a sale is rejected when stock is too low. true = stock may go negative (useful if stock counts are not kept up to date).
ALLOW_NEGATIVE_STOCK=false
